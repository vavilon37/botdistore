# Обязательные
BOT_TOKEN=your_token_here
ADMIN_IDS=123456789,987654321
CHANNEL_ID=-1001234567890

# Каталог для БД, кэшей прайсов и состояния монитора.
# На хостинге должен указывать на постоянный том, иначе данные
# затираются при каждой пересборке контейнера.
DATA_DIR=/app/data

# Интервал автообновления цен, секунды (по умолчанию 3600)
CHECK_INTERVAL=3600

# ID бота-источника прайсов, 0 — выключено
SOURCE_BOT_ID=0

# Синхронизация с Google Sheets (необязательно)
SHEETS_WEBAPP_URL=
SHEETS_TOKEN=
