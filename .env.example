# Обязательные
BOT_TOKEN=your_token_here
ADMIN_IDS=123456789,987654321
CHANNEL_ID=-1001234567890

# Каталог для БД, кэшей прайсов и состояния монитора.
# На хостинге должен указывать на постоянный том, иначе данные
# затираются при каждой пересборке контейнера.
DATA_DIR=/app/data

# Интервал автообновления цен, секунды (по умолчанию 3600)
CHECK_INTERVAL=3600

# ID бота-источника прайсов, 0 — выключено
SOURCE_BOT_ID=0

# Синхронизация с Google Sheets (необязательно)
SHEETS_WEBAPP_URL=
SHEETS_TOKEN=

# --- Чтение канала поставщика (Telethon) ---
# Нужно, если в канале включена защита контента: веб-превью тогда
# отдаёт страницу без текста. Без этих переменных бот работает
# по часовому опросу веб-версии.
# api_id / api_hash: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Строка сессии: python make_session.py на своём компьютере.
# Равнозначна доступу к аккаунту — только сюда, никогда в репозиторий.
TG_SESSION=
